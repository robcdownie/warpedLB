{
  "name": "warpedlb-companion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Unofficial offline-first planner PWA for Vans Warped Tour Long Beach 2026",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "shots": "npm run build && node scripts/shots.mjs",
    "verify": "npm run build && node scripts/verify-e2e.mjs",
    "assets:map": "node scripts/crop-map.mjs",
    "assets:icons": "node scripts/gen-icons.mjs",
    "assets:splash": "node scripts/gen-splash.mjs",
    "assets": "npm run assets:icons && npm run assets:splash"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "idb": "^8.0.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.469.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-zoom-pan-pinch": "^3.6.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@fontsource/archivo-black": "^5.1.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
